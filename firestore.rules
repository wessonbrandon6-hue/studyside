rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    // Private student profile and progress. A student can only read/write their own data.
    match /users/{uid} {
      allow read, create, update: if owns(uid);
      allow delete: if false;

      match /{document=**} {
        allow read, write: if owns(uid);
      }
    }

    // No public client writes to shared class data until teacher roles and
    // membership checks are implemented with trusted server-side claims.
    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if false;
      match /{document=**} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /publicContent/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}